# Local examples only. Set this in your shell; the API does not load .env files.
DATABASE_URL=postgresql+psycopg://library:local-password@127.0.0.1:5432/library
TEST_DATABASE_URL=postgresql+psycopg://library:local-password@127.0.0.1:5432/member_test
DYNAMODB_ENDPOINT_URL=http://127.0.0.1:8000
BOOKS_TABLE=Books
COPIES_TABLE=Copies
S3_ENDPOINT_URL=http://127.0.0.1:9000
# Public signing address when the API itself uses http://minio:9000 in Compose.
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
